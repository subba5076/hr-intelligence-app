# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:5173

# --- Database ---
# Local docker-compose default (see docker-compose.yml)
DATABASE_URL=postgresql://hrapp:hrapp_password@localhost:5432/hrapp

# --- LLM provider ---
# "openai" uses the real OpenAI API (needs OPENAI_API_KEY, paid).
# "groq"   uses Groq's free tier (needs GROQ_API_KEY -- get one free, no
#          credit card, at https://console.groq.com/keys). Real hosted LLM
#          answers at no cost.
# "mock"   uses a free, local, template-based responder -- no API key, no
#          network call at all, so the app runs end-to-end with nothing set up.
LLM_PROVIDER=mock
OPENAI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- RAG ---
HR_DOCS_DIR=../data/hr_docs
FAISS_INDEX_DIR=./storage/faiss_index
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

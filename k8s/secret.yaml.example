# TEMPLATE -- copy to secret.yaml, fill in real values, and NEVER commit
# secret.yaml to git (see .gitignore). In a real deployment you'd typically
# manage this via Azure Key Vault + the Secrets Store CSI driver instead of
# a raw Kubernetes Secret, but this is the minimal version.
#
# Apply with: kubectl apply -f k8s/secret.yaml
apiVersion: v1
kind: Secret
metadata:
  name: hrapp-secrets
  namespace: hr-intelligence
type: Opaque
stringData:
  DATABASE_URL: "postgresql://hrapp:REPLACE_ME@<your-postgres-host>:5432/hrapp"
  OPENAI_API_KEY: "sk-REPLACE_ME"

# Copy this to `.env` (same folder as docker-compose.yml) to switch the
# LLM provider without editing docker-compose.yml or rebuilding images.
# `.env` is gitignored -- your keys never get committed.

# mock (default, free/local) | groq (free tier, needs GROQ_API_KEY) | openai (paid, needs OPENAI_API_KEY)
LLM_PROVIDER=mock

# Free, no credit card: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Paid: https://platform.openai.com/api-keys
OPENAI_API_KEY=
